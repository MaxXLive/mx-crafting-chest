{
	"schemaVersion": 1,
	"id": "mxcraftingchest",
	"version": "${version}",
	"name": "MX Crafting Chest",
	"description": "Shows the inventory of a chest or barrel next to a crafting table to the left of the crafting screen, so you can take and store items while crafting. Must be installed on the server too (singleplayer works out of the box).",
	"authors": [
		"maxxlive"
	],
	"contact": {
		"sources": "https://github.com/MaxXLive/mx-crafting-chest",
		"issues": "https://github.com/MaxXLive/mx-crafting-chest/issues"
	},
	"license": "MIT",
	"icon": "assets/mxcraftingchest/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"de.ermackov.craftingchest.CraftingChest"
		],
		"client": [
			"de.ermackov.craftingchest.client.CraftingChestClient"
		]
	},
	"mixins": [
		"mxcraftingchest.mixins.json"
	],
	"accessWidener": "mxcraftingchest.classtweaker",
	"depends": {
		"fabricloader": ">=0.19.0",
		"fabric-api": "*",
		"minecraft": ">=26.3"
	}
}
